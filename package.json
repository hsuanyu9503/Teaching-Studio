{
  "name": "teaching-studio",
  "private": true,
  "version": "0.0.0",
  "description": "Teaching Studio｜通用教學簡報工作台（純前端，GitHub Pages）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "node scripts/check.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run && node --test tests/governance/*.test.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "e2e": "playwright test",
    "review:packet": "python3 scripts/export_review_packet.py"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
